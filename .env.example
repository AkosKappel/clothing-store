# Copy to .env (chmod 600). Never commit .env.

# --- Compose ---
CONTAINER_PREFIX=tagline
# On the server, also load the Tailscale sidecar:
#COMPOSE_FILE=docker-compose.yml:docker-compose.tailscale.yml
APP_BIND=127.0.0.1
APP_PORT=8083
DB_HOST_PORT=5435

# --- Database (Postgres applies the password only when the volume is first created) ---
DB_DATABASE=tagline
DB_USERNAME=tagline
DB_PASSWORD=
# Host-side mix (dev/test) connects through the published port:
DB_HOST=127.0.0.1
DB_PORT=5435

# --- Phoenix (prod) ---
# mix phx.gen.secret
SECRET_KEY_BASE=
PHX_HOST=tagline.tailb52c43.ts.net

# --- Demo ---
ADMIN_EMAIL=admin@eshop.com
ADMIN_PASSWORD=
DEMO_RESET_ENABLED=true
DEMO_RESET_TIME=03:00
DEMO_RESET_TIMEZONE=Europe/Bratislava

# A link that is not configured is not shown.
#DEMO_AUTHOR=Ákos Kappel
#DEMO_GITHUB_URL=https://github.com/AkosKappel
#DEMO_REPOSITORY_URL=https://github.com/AkosKappel/clothing-store
#DEMO_LINKEDIN_URL=https://www.linkedin.com/in/%C3%A1kos-kappel-b53344220/
#DEMO_PORTFOLIO_URL=
