# Copy to .env (chmod 600). Never commit .env.

# --- Compose ---
CONTAINER_PREFIX=tagline
# On the server, also load the Tailscale sidecar:
#COMPOSE_FILE=docker-compose.yml:docker-compose.tailscale.yml
# nginx also writes its access log here; the server points it at ~/logs/<app> for
# the traffic dashboard (absolute path). Default: ./tmp/nginx
#ACCESS_LOG_DIR=/home/akap/logs/tagline
APP_BIND=127.0.0.1
APP_PORT=8083
DB_HOST_PORT=5435

# --- Database (Postgres applies the password only when the volume is first created) ---
DB_DATABASE=tagline
DB_USERNAME=tagline
DB_PASSWORD=
# Optional non-superuser role for the app (hex password). Create it on an existing volume with
# `docker compose exec db bash /docker-entrypoint-initdb.d/02-app-role.sh`, then `docker compose up -d app`.
DB_APP_USERNAME=
DB_APP_PASSWORD=
# Host-side mix (dev/test) connects through the published port:
DB_HOST=127.0.0.1
DB_PORT=5435

# --- Phoenix (prod) ---
# mix phx.gen.secret
SECRET_KEY_BASE=
PHX_HOST=tagline.tailb52c43.ts.net
# Erlang distribution cookie for `bin/clothing_store rpc` (openssl rand -hex 32); empty keeps the image's own
RELEASE_COOKIE=

# --- Demo ---
ADMIN_EMAIL=admin@eshop.com
ADMIN_PASSWORD=
DEMO_RESET_ENABLED=true
DEMO_RESET_TIME=03:15
DEMO_RESET_TIMEZONE=Europe/Bratislava
# Simulated sales and restocks every few minutes (at most 300 sales a day)
DEMO_ACTIVITY_ENABLED=true
DEMO_ACTIVITY_INTERVAL=4

# About page: author and profile links. Defaults (config/config.exs): author Ákos Kappel;
# GitHub (https://github.com/AkosKappel), this repository and LinkedIn are set; portfolio
# is empty. A link without a URL is not shown. A non-empty value here overrides the default;
# an empty or commented-out value keeps it, so a default link can't be hidden from here
# (remove it in config/config.exs instead).
#DEMO_AUTHOR="Ákos Kappel"
#DEMO_GITHUB_URL=https://github.com/AkosKappel
#DEMO_REPOSITORY_URL=https://github.com/AkosKappel/clothing-store
#DEMO_LINKEDIN_URL=https://www.linkedin.com/in/akos-kappel
#DEMO_PORTFOLIO_URL=https://portfolio-taupe-eta-51.vercel.app
