# Production settings for deploy/compose.yaml. Copy to .env in the deploy folder, chmod 600.
COMPOSE_FILE=compose.yaml:compose.tailscale.yaml

# The image to run: a commit tag from GHCR (sha-1234567), set by deploy.sh.
IMAGE_TAG=sha-0000000

# Local access on the server (infra/hosting/ports.md)
APP_PORT=8083
# nginx's access log for the traffic dashboard (absolute path)
ACCESS_LOG_DIR=/home/akap/logs/tagline
# Database dumps made by deploy.sh before each deploy (14 days kept)
BACKUP_DIR=/home/akap/backups/tagline

# Database (Postgres applies the password only when the volume is first created)
DB_DATABASE=tagline
DB_USERNAME=tagline
DB_PASSWORD=
# The app's own non-superuser role (hex password)
DB_APP_USERNAME=
DB_APP_PASSWORD=

# Phoenix: mix phx.gen.secret
SECRET_KEY_BASE=
PHX_HOST=tagline.tailb52c43.ts.net
# Erlang distribution cookie for `bin/clothing_store rpc` (openssl rand -hex 32)
RELEASE_COOKIE=

# Demo
ADMIN_EMAIL=admin@eshop.com
ADMIN_PASSWORD=
DEMO_RESET_ENABLED=true
DEMO_RESET_TIME=03:15
DEMO_RESET_TIMEZONE=Europe/Bratislava
DEMO_ACTIVITY_ENABLED=true
DEMO_ACTIVITY_INTERVAL=4
