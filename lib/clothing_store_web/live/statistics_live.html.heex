<.header>
  {gettext("Sales Statistics")}
  <:subtitle>
    {gettext("How the store is doing: revenue, categories, stock and bestsellers.")}
  </:subtitle>
  <:actions>
    <.button type="button" variant="secondary" icon="hero-printer" data-print class="print:hidden">
      {gettext("Print report")}
    </.button>
  </:actions>
</.header>
<p class="mb-6 hidden text-sm text-gray-600 print:block">
  {gettext("Monthly report for %{month}, printed %{date}.",
    month: strftime(@this_month, "%B %Y"),
    date: Date.utc_today()
  )}
</p>

<dl class="grid grid-cols-2 gap-4 lg:grid-cols-4">
  <div class="card p-5">
    <dt class="flex items-center gap-2 text-sm text-gray-500">
      <.icon name="hero-banknotes" class="size-5" /> {gettext("Revenue this month")}
    </dt>
    <dd class="mt-2 text-2xl font-semibold text-gray-900 tabular-nums">
      {format_price(@this.revenue)}
    </dd>
    <dd class="mt-1 text-xs text-gray-500">
      {gettext("Last month: %{value}", value: format_price(@last.revenue))}
    </dd>
    <dd :if={Decimal.gt?(@discounts, 0)} class="mt-1 text-xs text-red-700">
      {gettext("Discounts given: −%{amount}", amount: format_price(@discounts))}
    </dd>
  </div>
  <div class="card p-5">
    <dt class="flex items-center gap-2 text-sm text-gray-500">
      <.icon name="hero-receipt-percent" class="size-5" /> {gettext("Transactions this month")}
    </dt>
    <dd class="mt-2 text-2xl font-semibold text-gray-900 tabular-nums">{@this.count}</dd>
    <dd class="mt-1 text-xs text-gray-500">
      {gettext("Last month: %{value}", value: @last.count)}
    </dd>
  </div>
  <div class="card p-5">
    <dt class="flex items-center gap-2 text-sm text-gray-500">
      <.icon name="hero-shopping-bag" class="size-5" /> {gettext("Average sale this month")}
    </dt>
    <dd class="mt-2 text-2xl font-semibold text-gray-900 tabular-nums">
      {if @this.count > 0, do: format_price(Decimal.div(@this.revenue, @this.count)), else: "–"}
    </dd>
    <dd class="mt-1 text-xs text-gray-500">
      {gettext("Last month: %{value}",
        value:
          if(@last.count > 0,
            do: format_price(Decimal.div(@last.revenue, @last.count)),
            else: "–"
          )
      )}
    </dd>
  </div>
  <div class="card p-5">
    <dt class="flex items-center gap-2 text-sm text-gray-500">
      <.icon name="hero-exclamation-triangle" class="size-5" /> {gettext("Out of stock")}
    </dt>
    <dd class="mt-2 text-2xl font-semibold text-gray-900 tabular-nums">
      {ngettext("1 product", "%{count} products", @stock_alerts.out)}
    </dd>
    <dd class="mt-1 text-xs text-gray-500">
      {ngettext("1 more is low on stock", "%{count} more are low on stock", @stock_alerts.low)}
    </dd>
    <dd :if={@stock_alerts.out + @stock_alerts.low > 0} class="mt-2 text-xs print:hidden">
      <.link
        href={~p"/products?low_stock=true&sort=stock_asc"}
        class="font-semibold text-red-700 hover:underline"
      >
        {gettext("Review and restock")}
      </.link>
    </dd>
  </div>
</dl>

<div class="mt-8 grid gap-6 lg:grid-cols-3">
  <section class="card min-w-0 p-5 sm:p-6 lg:col-span-2" aria-labelledby="revenue-title">
    <h2 id="revenue-title" class="font-semibold text-gray-900">{gettext("Revenue per month")}</h2>
    <p class="mt-1 mb-6 text-sm text-gray-500">
      {gettext("The last 12 months, this month so far.")}
    </p>
    <.bar_chart
      id="revenue-chart"
      title={gettext("Revenue per month over the last 12 months")}
      bars={revenue_bars(@monthly)}
      format={&short_euro/1}
    />
    <.chart_table
      headers={[gettext("Month"), gettext("Sales"), gettext("Revenue")]}
      rows={
        for m <- @monthly,
            do: [strftime(m.month, "%B %Y"), to_string(m.count), format_price(m.revenue)]
      }
    />
  </section>

  <section class="card min-w-0 p-5 sm:p-6" aria-labelledby="categories-title">
    <h2 id="categories-title" class="font-semibold text-gray-900">
      {gettext("Revenue by category")}
    </h2>
    <p class="mt-1 mb-6 text-sm text-gray-500">{gettext("The last 12 months.")}</p>
    <.donut_chart
      :if={@categories != []}
      id="category-chart"
      title={gettext("Revenue by category over the last 12 months")}
      segments={category_segments(@categories)}
      total_text={short_euro(sum_revenue(@categories))}
    />
    <.empty_state
      :if={@categories == []}
      icon="hero-chart-pie"
      title={gettext("No sales yet")}
      class="py-8"
    />
    <.chart_table
      :if={@categories != []}
      headers={[gettext("Category"), gettext("Revenue")]}
      rows={for {category, revenue} <- @categories, do: [category, format_price(revenue)]}
    />
  </section>
</div>

<h2 class="mt-12 mb-4 font-display text-xl font-bold text-gray-900">{gettext("Bestsellers")}</h2>
<div class="grid gap-8">
  <.bestsellers
    id="bestsellers-this-month"
    title={gettext("This month (%{month})", month: strftime(@this_month, "%B %Y"))}
    rows={@this_month_bestsellers}
    empty={gettext("No sales this month yet.")}
  />
  <.bestsellers
    id="bestsellers-last-month"
    title={gettext("Last month (%{month})", month: strftime(@last_month, "%B %Y"))}
    rows={@last_month_bestsellers}
    empty={gettext("No sales last month.")}
  />
  <.bestsellers
    id="bestsellers-all-time"
    title={gettext("All time")}
    rows={@bestsellers}
    empty={gettext("No sales recorded yet.")}
  />
</div>
