<.header>
  Product dashboard
  <:subtitle>
    <span class="inline-flex items-center gap-2">
      <span class="relative flex size-2.5" aria-hidden="true">
        <span class="absolute inline-flex size-full rounded-full bg-emerald-400 opacity-75 motion-safe:animate-ping"></span>
        <span class="relative inline-flex size-2.5 rounded-full bg-emerald-500"></span>
      </span>
      Live: changes made by other visitors appear here instantly.
    </span>
  </:subtitle>
  <:actions>
    <.button href={~p"/products/new"} icon="hero-plus">New product</.button>
  </:actions>
</.header>

<.empty_state :if={@products == []} image={~p"/images/logo.svg"} title="No products yet">
  Add the first product, or wait for the nightly reset to bring back the demo catalogue.
  <:actions>
    <.button href={~p"/products/new"} icon="hero-plus">New product</.button>
  </:actions>
</.empty_state>

<ul
  :if={@products != []}
  id="products"
  class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
>
  <li :for={product <- @products} id={"product-#{product.id}"}>
    <.link
      href={~p"/products/#{product.id}"}
      class="card group flex h-full flex-col overflow-hidden transition-shadow hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600"
    >
      <img
        src={image_link(product.photo)}
        alt=""
        class="aspect-4/3 w-full bg-gray-100 object-cover"
        loading="lazy"
      />
      <div class="flex flex-1 flex-col gap-3 p-5">
        <div class="flex items-start justify-between gap-4">
          <h2 class="font-semibold text-gray-900 group-hover:text-red-700">{product.title}</h2>
          <span class="font-semibold whitespace-nowrap text-gray-900">
            {format_price(product.price)}
          </span>
        </div>
        <p class="line-clamp-2 text-sm text-gray-600">{product.description}</p>
        <div class="mt-auto flex flex-wrap items-center justify-between gap-2 pt-2 text-sm">
          <.category_badge category={product.category} />
          <.stock_badge stock={product.stock} />
        </div>
        <div :if={product.tags != []} class="flex flex-wrap gap-1.5">
          <.badge :for={tag <- product.tags}>{tag}</.badge>
        </div>
      </div>
    </.link>
  </li>
</ul>
