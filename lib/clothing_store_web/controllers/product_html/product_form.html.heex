<.simple_form :let={f} for={@changeset} action={@action} class="card p-6 sm:p-8">
  <div
    :if={@changeset.action}
    role="alert"
    class="flex gap-3 rounded-md bg-rose-50 p-4 text-sm text-rose-900 ring-1 ring-rose-600/20"
  >
    <.icon name="hero-exclamation-circle-mini" class="size-5 shrink-0 text-rose-600" />
    <div>
      <p class="font-semibold">The product couldn't be saved. Please fix the errors below.</p>
      <p :for={msg <- translate_errors(@changeset.errors, :base)} class="mt-1">{msg}</p>
    </div>
  </div>

  <.input field={f[:title]} type="text" label="Title" maxlength="100" required />
  <.input
    field={f[:description]}
    type="textarea"
    label="Description"
    maxlength="2000"
    rows="4"
    required
  />
  <.input
    field={f[:photo]}
    type="text"
    label="Photo"
    placeholder="/images/products/t-shirt.webp"
    hint={"A path under /images/, or an https:// URL from #{ClothingStore.Products.Product.photo_hosts_text()}."}
    required
  />

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
    <.input field={f[:category]} type="text" label="Category" maxlength="50" required />
    <.input field={f[:price]} type="number" label="Price (€)" min="0" step="0.01" required />
    <.input field={f[:stock]} type="number" label="Stock" min="0" step="1" required />
  </div>

  <.input
    field={f[:tags]}
    type="text"
    label="Tags"
    value={f[:tags].value |> List.wrap() |> Enum.join(", ")}
    hint="Comma separated, for example: summer, sale"
  />

  <:actions>
    <div class="ml-auto flex flex-wrap items-center gap-3 border-t border-gray-100 pt-5">
      <.button href={@cancel_to} variant="secondary">Cancel</.button>
      <.button type="submit" icon="hero-check">Save product</.button>
    </div>
  </:actions>
</.simple_form>
