<div class="mx-auto max-w-3xl">
  <.back navigate={~p"/products"}>Inventory</.back>
  <.header>
    New Product
    <:subtitle>Add a product to the catalogue. All fields except tags are required.</:subtitle>
  </.header>

  <.product_form form={to_form(@changeset)} action={~p"/products"} cancel_to={~p"/products"} />
</div>
