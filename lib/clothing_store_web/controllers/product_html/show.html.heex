<.back navigate={~p"/products"}>Inventory</.back>
<.header>
  {@product.title}
  <:subtitle>Product Details · #{@product.id}</:subtitle>
  <:actions>
    <.button href={~p"/products/#{@product}/edit"} variant="secondary" icon="hero-pencil-square">
      Edit
    </.button>
    <.delete_dialog
      id="delete-product"
      action={~p"/products/#{@product}"}
      title={"Delete #{@product.title}?"}
    >
      The product and its stock are removed for every visitor. This can't be undone.
    </.delete_dialog>
  </:actions>
</.header>

<div class="card grid gap-8 p-6 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
  <img
    src={image_link(@product.photo)}
    alt={@product.title}
    class="aspect-square w-full rounded-md bg-gray-100 object-cover"
  />
  <.list>
    <:item title="Price">
      <span class="text-lg font-semibold">{format_price(@product.price)}</span>
    </:item>
    <:item title="Stock">
      <.stock_badge stock={@product.stock} />
    </:item>
    <:item title="Category"><.category_badge category={@product.category} /></:item>
    <:item title="Tags">
      <div class="flex flex-wrap gap-1.5">
        <.badge :for={tag <- @product.tags}>{tag}</.badge>
        <span :if={@product.tags == []} class="text-gray-400">No tags</span>
      </div>
    </:item>
    <:item title="Description">
      <p class="whitespace-pre-line">{@product.description}</p>
    </:item>
  </.list>
</div>
