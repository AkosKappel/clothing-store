<.header>
  Inventory
  <:subtitle>Every product with its stock. Filter by category, price, stock and tags.</:subtitle>
  <:actions>
    <.button href={~p"/products/new"} icon="hero-plus">New product</.button>
  </:actions>
</.header>

<section class="card mb-6 p-5" aria-labelledby="filters-title">
  <h2 id="filters-title" class="flex items-center gap-2 font-semibold text-gray-900">
    <.icon name="hero-funnel" class="size-5 text-gray-500" /> Filters
  </h2>
  <.form :let={f} for={%{}} action={~p"/products"} method="get" class="mt-4 space-y-5">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <.input
        field={f[:category]}
        type="select"
        label="Category"
        options={@categories}
        value={@filters["category"]}
      />
      <.input
        field={f[:min_price]}
        type="number"
        min="0"
        step="0.01"
        label="Min price (€)"
        placeholder="0,00"
        value={@filters["min_price"]}
      />
      <.input
        field={f[:max_price]}
        type="number"
        min="0"
        step="0.01"
        label="Max price (€)"
        placeholder="Any"
        value={@filters["max_price"]}
      />
      <label class="flex items-center gap-2 self-end pb-2 text-sm text-gray-700">
        <input
          type="checkbox"
          name="in_stock"
          value="true"
          class="size-4 rounded-sm border-gray-300 text-red-600 focus:ring-red-600"
          checked={@filters["in_stock"] == "true"}
        /> In stock only
      </label>
    </div>

    <fieldset :if={@tags != []}>
      <legend class="text-sm font-semibold text-gray-800">Tags</legend>
      <div class="mt-2 flex flex-wrap gap-2">
        <label :for={tag <- @tags} class="cursor-pointer">
          <input
            type="checkbox"
            name="tags[]"
            value={tag}
            class="peer sr-only"
            checked={tag in @filters["tags"]}
          />
          <span class="inline-flex items-center rounded-full px-3 py-1 text-sm font-medium text-gray-700 ring-1 ring-gray-300 transition-colors ring-inset peer-checked:bg-red-600 peer-checked:text-white peer-checked:ring-red-600 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-red-600 hover:bg-gray-50 peer-checked:hover:bg-red-700">
            {tag}
          </span>
        </label>
      </div>
    </fieldset>

    <div class="flex flex-wrap items-center justify-end gap-3 border-t border-gray-100 pt-4">
      <.button
        :if={filtered?(@filters)}
        href={~p"/products"}
        variant="secondary"
        icon="hero-x-mark"
      >
        Clear filters
      </.button>
      <.button type="submit" icon="hero-funnel">Apply filters</.button>
    </div>
  </.form>
</section>

<p :if={@products != []} class="mb-3 text-sm text-gray-600">
  {ngettext("1 product", "%{count} products", length(@products))}
</p>

<.table id="products" rows={@products} row_id={&"product-#{&1.id}"}>
  <:col :let={product} label="Product">
    <div class="flex items-center gap-4 sm:min-w-64">
      <img
        src={image_link(product.photo)}
        alt=""
        class="size-14 shrink-0 rounded-md bg-gray-100 object-cover"
        loading="lazy"
      />
      <div class="min-w-0">
        <.link
          href={~p"/products/#{product}"}
          class="font-semibold text-gray-900 hover:text-red-700 hover:underline"
        >
          {product.title}
        </.link>
        <p class="line-clamp-1 max-w-xs text-gray-500">{product.description}</p>
      </div>
    </div>
  </:col>
  <:col :let={product} label="Category"><.category_badge category={product.category} /></:col>
  <:col :let={product} label="Tags">
    <div class="flex flex-wrap gap-1.5">
      <.badge :for={tag <- product.tags}>{tag}</.badge>
      <span :if={product.tags == []} class="text-gray-400">–</span>
    </div>
  </:col>
  <:col :let={product} label="Price" class="text-right whitespace-nowrap">
    {format_price(product.price)}
  </:col>
  <:col :let={product} label="Stock" class="text-right whitespace-nowrap">
    <.stock_badge stock={product.stock} />
  </:col>
  <:action :let={product}>
    <.button
      href={~p"/products/#{product}/edit"}
      variant="secondary"
      size="sm"
      icon="hero-pencil-square"
    >
      Edit<span class="sr-only">, {product.title}</span>
    </.button>
    <.delete_dialog
      id={"delete-product-#{product.id}"}
      action={~p"/products/#{product}"}
      title={"Delete #{product.title}?"}
      size="sm"
    >
      The product and its stock are removed for every visitor. This can't be undone.
    </.delete_dialog>
  </:action>
  <:empty>
    <.empty_state
      :if={filtered?(@filters)}
      icon="hero-magnifying-glass"
      title="No products match these filters"
    >
      Try a wider price range, another category or fewer tags.
      <:actions>
        <.button href={~p"/products"} variant="secondary" icon="hero-x-mark">
          Clear filters
        </.button>
      </:actions>
    </.empty_state>
    <.empty_state :if={!filtered?(@filters)} image={~p"/images/logo.svg"} title="No products yet">
      Add the first product to start tracking stock.
      <:actions>
        <.button href={~p"/products/new"} icon="hero-plus">New product</.button>
      </:actions>
    </.empty_state>
  </:empty>
</.table>
