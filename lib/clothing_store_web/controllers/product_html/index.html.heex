<.header>
  {gettext("Inventory")}
  <:subtitle>
    {gettext("Every product with its stock. Search, filter and sort the catalogue.")}
  </:subtitle>
  <:actions>
    <.button
      href={~p"/inventory.csv?#{export_params(@filters)}"}
      variant="secondary"
      icon="hero-arrow-down-tray"
      download
    >
      {gettext("Export CSV")}
    </.button>
    <.button navigate={~p"/products/import"} variant="secondary" icon="hero-arrow-up-tray">
      {gettext("Import CSV")}
    </.button>
    <.button navigate={~p"/products/new"} icon="hero-plus" data-shortcut="n" aria-keyshortcuts="n">
      {gettext("New product")}
      <kbd class="ml-1 hidden rounded-sm bg-black/20 px-1.5 font-sans text-xs sm:inline">N</kbd>
    </.button>
  </:actions>
</.header>

<section class="card mb-6 p-5" aria-labelledby="filters-title">
  <h2 id="filters-title" class="flex items-center gap-2 font-semibold text-gray-900">
    <.icon name="hero-funnel" class="size-5 text-gray-500" /> {gettext("Filters")}
  </h2>
  <.form
    :let={f}
    for={%{}}
    id="filters-form"
    action={~p"/products"}
    method="get"
    phx-change="filter"
    phx-submit="filter"
    class="mt-4 space-y-5"
  >
    <.input
      field={f[:q]}
      type="search"
      label={gettext("Search")}
      placeholder={gettext("Title, description, category or tag (press /)")}
      value={@filters["q"]}
      data-shortcut="/"
      aria-keyshortcuts="/"
      maxlength="100"
      phx-debounce="300"
    />
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <.input
        field={f[:category]}
        type="select"
        label={gettext("Category")}
        options={@categories}
        value={@filters["category"]}
      />
      <.input
        field={f[:min_price]}
        type="number"
        phx-debounce="300"
        min="0"
        step="0.01"
        label={gettext("Min price (€)")}
        placeholder="0,00"
        value={@filters["min_price"]}
      />
      <.input
        field={f[:max_price]}
        type="number"
        phx-debounce="300"
        min="0"
        step="0.01"
        label={gettext("Max price (€)")}
        placeholder={gettext("Any")}
        value={@filters["max_price"]}
      />
      <label class="flex items-center gap-2 self-end pb-2 text-sm text-gray-700">
        <input
          type="checkbox"
          name="in_stock"
          value="true"
          class="size-4 rounded-sm border-gray-300 text-red-600 focus:ring-red-600"
          checked={@filters["in_stock"] == "true"}
        /> {gettext("In stock only")}
      </label>
    </div>
    <label class="flex items-center gap-2 text-sm text-gray-700">
      <input
        type="checkbox"
        name="low_stock"
        value="true"
        class="size-4 rounded-sm border-gray-300 text-red-600 focus:ring-red-600"
        checked={@filters["low_stock"] == "true"}
      /> {gettext("Low or out of stock only")}
    </label>

    <fieldset :if={@tags != []}>
      <legend class="text-sm font-semibold text-gray-800">{gettext("Tags")}</legend>
      <div class="mt-2 flex flex-wrap gap-2">
        <label :for={tag <- @tags} class="cursor-pointer">
          <input
            type="checkbox"
            name="tags[]"
            value={tag}
            class="peer sr-only"
            checked={tag in @filters["tags"]}
          />
          <span class="inline-flex items-center rounded-full px-3 py-1 text-sm font-medium text-gray-700 ring-1 ring-gray-300 transition-colors ring-inset peer-checked:bg-red-600 peer-checked:text-white peer-checked:ring-red-600 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-red-600 hover:bg-gray-50 peer-checked:hover:bg-red-700 dark:peer-checked:hover:bg-red-500">
            {tag}
          </span>
        </label>
      </div>
    </fieldset>

    <div class="flex flex-wrap items-center justify-end gap-3 border-t border-gray-100 pt-4">
      <.button
        :if={filtered?(@filters)}
        patch={~p"/products"}
        variant="secondary"
        icon="hero-x-mark"
      >
        {gettext("Clear filters")}
      </.button>
      <.button type="submit" icon="hero-funnel">{gettext("Apply filters")}</.button>
    </div>
  </.form>
</section>

<div class="mb-3 flex flex-wrap items-center justify-between gap-3">
  <div class="flex flex-wrap items-center gap-2">
    <p class="text-sm text-gray-600">
      {ngettext("1 product", "%{count} products", length(@products))}
    </p>
    <.link
      :for={{label, params} <- filter_chips(@filters)}
      patch={~p"/products?#{params}"}
      class="inline-flex items-center gap-1 rounded-full bg-gray-100 py-1 pr-1.5 pl-3 text-xs font-medium text-gray-700 ring-1 ring-gray-200 ring-inset hover:bg-gray-200 focus-visible:outline-2 focus-visible:outline-red-600"
    >
      {label}
      <.icon name="hero-x-mark-mini" class="size-4" />
      <span class="sr-only">{gettext("(remove this filter)")}</span>
    </.link>
  </div>
  <div :if={@products != []} class="flex items-center gap-2">
    <label for="sort" class="text-sm text-gray-600">{gettext("Sort by")}</label>
    <select
      id="sort"
      name="sort"
      form="filters-form"
      data-autosubmit
      class="rounded-md border-gray-300 py-1.5 pr-8 text-sm shadow-xs focus:border-red-600 focus:ring-red-600"
    >
      {Phoenix.HTML.Form.options_for_select(sort_options(), @filters["sort"] || "newest")}
    </select>
    <noscript><.button type="submit" form="filters-form" size="sm" variant="secondary">
      {gettext("Sort")}
    </.button></noscript>
  </div>
</div>

<.table id="products" rows={@products} row_id={&"product-#{&1.id}"}>
  <:col :let={product} label={gettext("Product")}>
    <div class="flex items-center gap-4 sm:min-w-64">
      <img
        src={image_link(product.photo)}
        alt=""
        class="size-14 shrink-0 rounded-md bg-gray-100 object-cover"
        loading="lazy"
      />
      <div class="min-w-0">
        <.link
          patch={inventory_path(@filters, product)}
          class="font-semibold text-gray-900 hover:text-red-700 hover:underline"
          aria-haspopup="dialog"
        >
          {product.title}
        </.link>
        <p class="line-clamp-1 max-w-xs text-gray-500">{product.description}</p>
      </div>
    </div>
  </:col>
  <:col :let={product} label={gettext("Category")}>
    <.category_badge category={product.category} />
  </:col>
  <:col :let={product} label={gettext("Tags")}>
    <div class="flex flex-wrap gap-1.5">
      <.badge :for={tag <- product.tags}>{tag}</.badge>
      <span :if={product.tags == []} class="text-gray-400">–</span>
    </div>
  </:col>
  <:col :let={product} label={gettext("Price")} class="text-right whitespace-nowrap">
    <.price product={product} />
  </:col>
  <:col :let={product} label={gettext("Stock")} class="text-right whitespace-nowrap">
    <.stock_badge stock={product.stock} />
  </:col>
  <:action :let={product}>
    <.button
      navigate={~p"/products/#{product}/edit"}
      variant="secondary"
      size="sm"
      icon="hero-pencil-square"
    >
      {gettext("Edit")}<span class="sr-only">, {product.title}</span>
    </.button>
    <.delete_dialog
      id={"delete-product-#{product.id}"}
      action={~p"/products/#{product}"}
      title={gettext("Delete %{title}?", title: product.title)}
      size="sm"
    >
      {gettext("The product and its stock are removed for every visitor. This can't be undone.")}
    </.delete_dialog>
  </:action>
  <:empty>
    <.empty_state
      :if={filtered?(@filters)}
      icon="hero-magnifying-glass"
      title={gettext("No products match these filters")}
    >
      {gettext("Try a wider price range, another category or fewer tags.")}
      <:actions>
        <.button patch={~p"/products"} variant="secondary" icon="hero-x-mark">
          {gettext("Clear filters")}
        </.button>
      </:actions>
    </.empty_state>
    <.empty_state
      :if={!filtered?(@filters)}
      image={~p"/images/logo.svg"}
      title={gettext("No products yet")}
    >
      {gettext("Add the first product to start tracking stock.")}
      <:actions>
        <.button navigate={~p"/products/new"} icon="hero-plus">{gettext("New product")}</.button>
      </:actions>
    </.empty_state>
  </:empty>
</.table>

<.drawer :if={@selected} id="product-drawer" close={inventory_path(@filters)}>
  <:title>{@selected.title}</:title>
  <:subtitle>{gettext("Product Details")} · #{@selected.id}</:subtitle>
  <img
    src={image_link(@selected.photo)}
    alt={@selected.title}
    class="aspect-[4/3] w-full rounded-md bg-gray-100 object-cover"
  />
  <.list>
    <:item title={gettext("Price")}><.price product={@selected} class="text-lg" /></:item>
    <:item title={gettext("Stock")}>
      <div class="flex flex-wrap items-center gap-3">
        <.stock_badge stock={@selected.stock} />
        <.variant_stock variants={@selected.variants} />
      </div>
    </:item>
    <:item title={gettext("Forecast")}>
      <p>
        {ngettext(
          "1 sold in the last %{days} days.",
          "%{count} sold in the last %{days} days.",
          @sold,
          days: @forecast_days
        )}
        <span :if={@selected.stock > 0 && @days_left}>
          {ngettext(
            "At that pace it runs out in about 1 day.",
            "At that pace it runs out in about %{count} days.",
            @days_left
          )}
        </span>
      </p>
      <.sparkline
        :if={@sold > 0}
        id="drawer-sparkline"
        class="mt-3"
        points={@daily}
        title={gettext("Units sold per day over the last %{days} days", days: @forecast_days)}
      />
    </:item>
    <:item title={gettext("Category")}><.category_badge category={@selected.category} /></:item>
    <:item title={gettext("Tags")}>
      <div class="flex flex-wrap gap-1.5">
        <.badge :for={tag <- @selected.tags}>{tag}</.badge>
        <span :if={@selected.tags == []} class="text-gray-400">{gettext("No tags")}</span>
      </div>
    </:item>
    <:item title={gettext("Description")}>{@selected.description}</:item>
  </.list>
  <:actions>
    <.button
      navigate={~p"/products/#{@selected}"}
      variant="secondary"
      icon="hero-arrow-top-right-on-square"
    >
      {gettext("Open full page")}
    </.button>
    <.button navigate={~p"/products/#{@selected}/edit"} icon="hero-pencil-square">
      {gettext("Edit")}
    </.button>
  </:actions>
</.drawer>
