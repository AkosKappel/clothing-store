<div class="mx-auto max-w-3xl">
  <.back navigate={~p"/products/#{@product}"}>{@product.title}</.back>
  <.header>
    Edit Product
    <:subtitle>Changes are shown to every visitor straight away.</:subtitle>
  </.header>

  <.product_form
    form={to_form(@changeset)}
    action={~p"/products/#{@product}"}
    cancel_to={~p"/products/#{@product}"}
  />
</div>
