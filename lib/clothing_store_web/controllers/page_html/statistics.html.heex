<.header>
  Sales Statistics
  <:subtitle>The three best-selling products by quantity sold.</:subtitle>
</.header>

<div class="grid gap-8">
  <.bestsellers
    id="bestsellers-all-time"
    title="All time"
    rows={@bestsellers}
    empty="No sales recorded yet."
  />
  <.bestsellers
    id="bestsellers-this-month"
    title={"This month (#{Calendar.strftime(@this_month, "%B %Y")})"}
    rows={@this_month_bestsellers}
    empty="No sales this month yet."
  />
  <.bestsellers
    id="bestsellers-last-month"
    title={"Last month (#{Calendar.strftime(@last_month, "%B %Y")})"}
    rows={@last_month_bestsellers}
    empty="No sales last month."
  />
</div>
