<.header>
  Transactions
  <:subtitle>
    {if @month_label, do: "Sales in #{@month_label}.", else: "Every sale, newest first."}
  </:subtitle>
</.header>

<section class="card mb-6 p-5">
  <.form
    :let={f}
    for={%{}}
    action={~p"/transactions"}
    method="get"
    class="flex flex-wrap items-end gap-3"
  >
    <div class="w-full sm:w-56">
      <.input field={f[:month]} type="month" value={@selected_month} label="Month" />
    </div>
    <.button type="submit" icon="hero-funnel">Filter</.button>
    <.button :if={@selected_month} href={~p"/transactions"} variant="secondary" icon="hero-x-mark">
      Show all
    </.button>
  </.form>
</section>

<dl :if={@transactions != []} class="mb-6 grid grid-cols-2 gap-4 sm:max-w-md">
  <div class="card p-4">
    <dt class="text-sm text-gray-500">Transactions</dt>
    <dd class="mt-1 text-2xl font-semibold text-gray-900">{length(@transactions)}</dd>
  </div>
  <div class="card p-4">
    <dt class="text-sm text-gray-500">Revenue</dt>
    <dd class="mt-1 text-2xl font-semibold text-gray-900">{format_price(@revenue)}</dd>
  </div>
</dl>

<.table id="transactions" rows={@transactions}>
  <:col :let={transaction} label="ID" class="whitespace-nowrap">
    <span class="font-semibold text-gray-900">#{transaction.id}</span>
  </:col>
  <:col :let={transaction} label="Date" class="whitespace-nowrap">
    <time
      datetime={DateTime.to_iso8601(transaction.inserted_at)}
      title={format_date(transaction.inserted_at)}
    >
      {relative_time(transaction.inserted_at)}
    </time>
  </:col>
  <:col :let={transaction} label="Products">
    <ul class="space-y-1">
      <li :for={item <- transaction.products_transactions}>
        <.link
          href={~p"/products/#{item.product}"}
          class="text-gray-900 hover:text-red-700 hover:underline"
        >
          {item.product.title}
        </.link>
        <span class="text-gray-500">× {item.quantity}</span>
      </li>
    </ul>
  </:col>
  <:col :let={transaction} label="Total" class="text-right font-semibold whitespace-nowrap">
    {format_price(transaction.total_price)}
  </:col>
  <:empty>
    <.empty_state
      :if={@selected_month}
      icon="hero-calendar"
      title={"No transactions in #{@month_label}"}
    >
      Pick another month, or show every transaction.
      <:actions>
        <.button href={~p"/transactions"} variant="secondary" icon="hero-x-mark">Show all</.button>
      </:actions>
    </.empty_state>
    <.empty_state :if={!@selected_month} icon="hero-receipt-percent" title="No transactions yet">
      Sales appear here as soon as they are recorded.
    </.empty_state>
  </:empty>
</.table>
