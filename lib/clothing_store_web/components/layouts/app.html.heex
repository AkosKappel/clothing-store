<header class="relative px-4 sm:px-6 lg:px-8 bg-gray-800 text-white h-24 pt-2">
  <div class="mx-auto max-w-7xl flex items-center justify-between py-3 text-sm">
    <div class="flex items-center gap-4">
      <a href="/" class="flex items-center">
        <img src={~p"/images/logo.svg"} width="48" alt="Clothing Store Logo" />
        <span class="ml-2 text-3xl font-bold text-red-400 italic">
          Modern Fashion Store
        </span>
      </a>
    </div>

    <div class="block lg:hidden">
      <button
        id="menu-toggle"
        class="text-white hover:text-gray-400 focus:outline-hidden focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white rounded-xs"
        aria-label="Toggle Menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="w-6 h-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16m-7 6h7"
          />
        </svg>
      </button>
    </div>

    <div class="hidden">
      {active_path = ClothingStoreWeb.Helpers.current_path(assigns)}
    </div>

    <ul
      id="menu"
      class="hidden lg:flex items-center font-semibold bg-gray-800 lg:bg-transparent lg:static absolute top-24 left-0 w-full lg:w-auto lg:py-0 pb-4 lg:px-0 px-8 z-50 gap-x-8"
    >
      <%= if assigns[:current_user] do %>
        <li class="flex items-center justify-end my-2">
          <.link
            href={~p"/products"}
            class={if active_path == "/products", do: "text-red-400", else: "hover:text-zinc-400"}
          >
            Inventory
          </.link>
        </li>
        <li class="flex items-center justify-end my-2">
          <.link
            href={~p"/transactions"}
            class={
              if active_path == "/transactions", do: "text-red-400", else: "hover:text-zinc-400"
            }
          >
            Transactions
          </.link>
        </li>
        <li class="flex items-center justify-end my-2">
          <.link
            href={~p"/statistics"}
            class={
              if active_path == "/statistics", do: "text-red-400", else: "hover:text-zinc-400"
            }
          >
            Statistics
          </.link>
        </li>
        <%!-- <li class="flex items-center justify-end my-2">
          <.link
            href={~p"/users/settings"}
            class={if active_path == "/edit", do: "text-red-400", else: "hover:text-zinc-400"}>
            Settings
          </.link>
        </li> --%>
      <% end %>
      <li class="flex items-center justify-end my-2">
        <.link
          href={~p"/about"}
          class={if active_path == "/about", do: "text-red-400", else: "hover:text-zinc-400"}
          aria-current={if active_path == "/about", do: "page"}
        >
          About
        </.link>
      </li>
      <li :if={assigns[:current_user]} class="flex items-center justify-end my-2">
        <.link
          href={~p"/users/log_out"}
          method="delete"
          class="hover:text-zinc-200 bg-red-600 px-4 py-2 rounded-sm"
        >
          Log out
        </.link>
      </li>
      <li :if={!assigns[:current_user]} class="flex items-center justify-end my-2">
        <.link
          href={~p"/users/log_in"}
          class="hover:text-zinc-200 bg-red-600 px-4 py-2 rounded-sm"
        >
          Log in
        </.link>
      </li>
    </ul>
  </div>
</header>

<main class="min-h-screen px-4 py-8 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <.flash_group flash={@flash} /> {@inner_content}
  </div>
</main>

<footer class="bg-gray-800 text-white py-4 mt-12">
  <div class="max-w-7xl mx-auto text-center">
    <p>&copy; {Date.utc_today().year} Modern Fashion Store. All rights reserved.</p>
    <p class="mt-1 text-sm">
      <.link href={~p"/about"} class="underline underline-offset-4 hover:text-zinc-300">
        About this project
      </.link>
    </p>
  </div>
</footer>
