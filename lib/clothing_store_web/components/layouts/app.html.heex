<% current_path = ClothingStoreWeb.Helpers.current_path(assigns) %>
<header class="relative bg-gray-800 text-white [view-transition-name:site-header]">
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8"
    aria-label="Main"
  >
    <a
      href="/"
      class="flex items-center gap-2 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
    >
      <img src={~p"/images/logo.svg"} width="40" height="40" alt="" />
      <span class="font-display text-xl font-bold whitespace-nowrap text-red-400 italic sm:text-2xl">
        Modern Fashion Store
      </span>
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="rounded-md p-2 text-gray-200 hover:bg-gray-700 hover:text-white focus-visible:outline-2 focus-visible:outline-white lg:hidden"
      aria-controls="menu"
      aria-expanded="false"
      aria-label="Toggle menu"
      title="Menu"
    >
      <.icon name="hero-bars-3" />
    </button>

    <ul
      id="menu"
      class="absolute top-full left-0 z-40 hidden w-full space-y-1 bg-gray-800 px-4 pb-4 shadow-lg max-lg:motion-safe:transition-[opacity,translate] max-lg:motion-safe:starting:-translate-y-2 max-lg:motion-safe:starting:opacity-0 lg:static lg:flex lg:w-auto lg:items-center lg:gap-1 lg:space-y-0 lg:p-0 lg:shadow-none"
    >
      <%= if assigns[:current_user] do %>
        <.nav_link href={~p"/"} current_path={current_path} icon="hero-squares-2x2">Dashboard</.nav_link>
        <.nav_link href={~p"/products"} current_path={current_path} icon="hero-cube">Inventory</.nav_link>
        <.nav_link href={~p"/transactions"} current_path={current_path} icon="hero-banknotes">Transactions</.nav_link>
        <.nav_link href={~p"/statistics"} current_path={current_path} icon="hero-chart-bar">Statistics</.nav_link>
      <% end %>
      <.nav_link href={~p"/about"} current_path={current_path} icon="hero-information-circle">About</.nav_link>
      <li :if={assigns[:current_user]} class="pt-2 lg:pt-0 lg:pl-3">
        <.link
          href={~p"/users/log_out"}
          method="delete"
          class="inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-semibold whitespace-nowrap text-gray-200 ring-1 ring-gray-600 ring-inset hover:bg-gray-700 hover:text-white focus-visible:outline-2 focus-visible:outline-white"
        >
          <.icon name="hero-arrow-right-start-on-rectangle-mini" /> Log out
        </.link>
      </li>
      <li
        :if={!assigns[:current_user] && current_path != ~p"/users/log_in"}
        class="pt-2 lg:pt-0 lg:pl-3"
      >
        <.link
          href={~p"/users/log_in"}
          class="inline-flex items-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-white"
        >
          Log in
        </.link>
      </li>
    </ul>
  </nav>
</header>

<main class="min-h-[70vh] px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
  <div class="mx-auto max-w-7xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>

<footer class="mt-12 bg-gray-800 py-6 text-sm text-gray-300">
  <div class="mx-auto max-w-7xl px-4 text-center">
    <p>&copy; {Date.utc_today().year} Modern Fashion Store. All rights reserved.</p>
    <p class="mt-1">
      <.link href={~p"/about"} class="underline underline-offset-4 hover:text-white">
        About this project
      </.link>
    </p>
  </div>
</footer>
