<% current_path = ClothingStoreWeb.Helpers.current_path(assigns) %>
<header class="relative bg-ink-800 print:hidden text-white [view-transition-name:site-header]">
  <a
    href="#main"
    class="sr-only z-50 rounded-md bg-surface px-4 py-2 font-semibold text-ink-900 shadow-lg focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus-visible:outline-2 focus-visible:outline-red-600"
  >
    {gettext("Skip to content")}
  </a>
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8"
    aria-label={gettext("Main")}
  >
    <a
      href="/"
      class="flex items-center gap-2 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
    >
      <img src={~p"/images/logo.svg"} width="40" height="40" alt="" />
      <span class="font-display text-xl font-bold whitespace-nowrap text-red-400 italic sm:text-2xl lg:text-xl 2xl:text-2xl">
        Modern Fashion Store
      </span>
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="rounded-md p-2 text-ink-200 hover:bg-ink-700 hover:text-white focus-visible:outline-2 focus-visible:outline-white lg:hidden"
      aria-controls="menu"
      aria-expanded="false"
      aria-label={gettext("Toggle menu")}
      title={gettext("Menu")}
    >
      <.icon name="hero-bars-3" />
    </button>

    <ul
      id="menu"
      class="absolute top-full left-0 z-40 hidden w-full space-y-1 bg-ink-800 px-4 pb-4 shadow-lg max-lg:motion-safe:transition-[opacity,translate] max-lg:motion-safe:starting:-translate-y-2 max-lg:motion-safe:starting:opacity-0 lg:static lg:flex lg:w-auto lg:items-center lg:gap-1 lg:space-y-0 lg:p-0 lg:shadow-none"
    >
      <%= if assigns[:current_user] do %>
        <.nav_link href={~p"/"} current_path={current_path} icon="hero-squares-2x2">{gettext(
          "Dashboard"
        )}</.nav_link>
        <.nav_link href={~p"/products"} current_path={current_path} icon="hero-cube">{gettext(
          "Inventory"
        )}</.nav_link>
        <.nav_link href={~p"/transactions"} current_path={current_path} icon="hero-banknotes">{gettext(
          "Transactions"
        )}</.nav_link>
        <.nav_link href={~p"/statistics"} current_path={current_path} icon="hero-chart-bar">{gettext(
          "Statistics"
        )}</.nav_link>
      <% end %>
      <.nav_link href={~p"/about"} current_path={current_path} icon="hero-information-circle">{gettext(
        "About"
      )}</.nav_link>
      <li>
        <button
          id="theme-toggle"
          type="button"
          class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-sm font-semibold text-ink-200 hover:bg-ink-700 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          aria-label={gettext("Theme: follows the system")}
          title={gettext("Theme: follows the system")}
          data-label-system={gettext("Theme: follows the system")}
          data-label-light={gettext("Theme: light")}
          data-label-dark={gettext("Theme: dark")}
        >
          <.icon name="hero-computer-desktop" class="size-5 opacity-80" data-theme-icon="system" />
          <.icon name="hero-sun" class="hidden size-5 opacity-80" data-theme-icon="light" />
          <.icon name="hero-moon" class="hidden size-5 opacity-80" data-theme-icon="dark" />
          <span class="lg:sr-only">{gettext("Theme")}</span>
        </button>
      </li>
      <li
        id="language"
        class="flex items-center gap-1 px-3 py-2 lg:px-1"
        role="group"
        aria-label={gettext("Language")}
      >
        <a
          :for={{locale, name} <- [{"en", "English"}, {"de", "Deutsch"}, {"sk", "Slovenčina"}]}
          href={"?locale=#{locale}"}
          hreflang={locale}
          lang={locale}
          title={name}
          aria-label={name}
          aria-current={locale == Gettext.get_locale(ClothingStoreWeb.Gettext) && "true"}
          class="rounded-md px-1.5 py-0.5 text-xs font-semibold text-ink-300 uppercase hover:bg-ink-700 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white aria-[current]:bg-ink-700 aria-[current]:text-white"
        >
          {locale}
        </a>
      </li>
      <li>
        <button
          type="button"
          commandfor="welcome"
          command="show-modal"
          class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-sm font-semibold text-ink-200 hover:bg-ink-700 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          title={gettext("What is this demo?")}
        >
          <.icon name="hero-question-mark-circle" class="size-5 opacity-80" />
          <span class="lg:sr-only">{gettext("Demo info")}</span>
        </button>
      </li>
      <li :if={assigns[:current_user]} class="pt-2 lg:pt-0 lg:pl-3">
        <.link
          href={~p"/users/log_out"}
          method="delete"
          class="inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-semibold whitespace-nowrap text-ink-200 ring-1 ring-ink-600 ring-inset hover:bg-ink-700 hover:text-white focus-visible:outline-2 focus-visible:outline-white"
        >
          <.icon name="hero-arrow-right-start-on-rectangle-mini" /> {gettext("Log out")}
        </.link>
      </li>
      <li
        :if={!assigns[:current_user] && current_path != ~p"/users/log_in"}
        class="pt-2 lg:pt-0 lg:pl-3"
      >
        <.link
          href={~p"/users/log_in"}
          class="inline-flex items-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white hover:bg-red-700 dark:hover:bg-red-500 focus-visible:outline-2 focus-visible:outline-white"
        >
          {gettext("Log in")}
        </.link>
      </li>
    </ul>
  </nav>
</header>

<main
  id="main"
  tabindex="-1"
  class="min-h-[70vh] focus:outline-none px-4 py-8 sm:px-6 lg:px-8 lg:py-10"
>
  <div class="mx-auto max-w-7xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>

<.site_footer />
