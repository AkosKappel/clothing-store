<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="description" content={meta_description(assigns)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Modern Fashion Store" />
    <meta
      property="og:title"
      content={(assigns[:page_title] || "Dashboard") <> " | Modern Fashion Store"}
    />
    <meta property="og:description" content={meta_description(assigns)} />
    <meta property="og:image" content={url(~p"/images/og-image.jpg")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={~p"/favicon.ico"} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={~p"/favicon.svg"} />
    <.live_title default="Dashboard" suffix=" | Modern Fashion Store">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-gray-50 text-gray-900 antialiased">
    <.welcome_dialog
      open_on_load={!@conn.cookies["welcome_seen"]}
      logged_in={@conn.assigns[:current_user] != nil}
    />
    {@inner_content}
  </body>
</html>
