#!/bin/sh
# Release environment, sourced by bin/clothing_store before every command.

# Erlang distribution (only used by `bin/clothing_store rpc`/`remote` inside the
# container) listens on loopback, never on the Docker network.
export ERL_EPMD_ADDRESS=127.0.0.1
export ELIXIR_ERL_OPTIONS="-kernel inet_dist_use_interface {127,0,0,1}"
# the default node name uses the container's hostname, which resolves to its network
# address; rpc would then miss the loopback-only listener
export RELEASE_DISTRIBUTION=sname
export RELEASE_NODE="${RELEASE_NODE:-<%= @release.name %>@localhost}"

# The runtime config is written here at boot; the container's filesystem is read-only.
export RELEASE_TMP="${RELEASE_TMP:-/tmp}"
